---
import Layout from "../layouts/Layout.astro";
import HeroTitle from "../components/ui/HeroTitle.astro";
import Card from "../components/Card";
import { variablesCardLink } from "../api/variablesCardLink";

import {AcademicoDashboard} from "../components/login/AcademicoDashboard"
---

<Layout
  title="Sistema Academico ESAM"
  canonical="https://academico-docentes.esam.edu.bo/"
  description="Sistema académico de ESAM para contratación y postulación de docentes."
>
<AcademicoDashboard client:load/>
  <HeroTitle titulo="Menú Principal" />
  


  <div class="contenidoCentral">
    {
      variablesCardLink.map((boton) => (
      <Card title={boton.titulo} image={boton.imagen} href={boton.href} />
      ))
    }
  </div>
</Layout>
<style is:global>
    .contenidoCentral {
    display: grid;
    grid-template-columns: repeat(auto-fill, 220px); /* Ancho exacto de las tarjetas */
    justify-content: center;
    gap: 20px; /* Reducir espacio entre tarjetas */
    padding: 20px;
    margin: 1rem auto;
    max-width: calc(220px * 4 + 20px * 3); /* Máximo para 4 columnas */
    animation-name: iniciar;
    animation-duration: 1s;
    animation-iteration-count: 1;
  }


  /* Para pantallas grandes (4 columnas) */
  @media (min-width: 1200px) {
    .contenidoCentral {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Pantallas medianas (3 columnas) */
  @media (max-width: 1199px) and (min-width: 768px) {
    .contenidoCentral {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Pantallas pequeñas (2 columnas) */
  @media (max-width: 767px) and (min-width: 480px) {
    .contenidoCentral {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Móviles (1 columna) */
  @media (max-width: 479px) {
    .contenidoCentral {
      grid-template-columns: 1fr;
    }
  }

  .card {
    width: 100%; /* Ocupa todo el espacio del grid item */
    max-width: 220px; /* Máximo ancho de cada tarjeta */
    margin: 0 auto; /* Centrar en su contenedor */
  }

  /* Eliminar o ajustar estos estilos si no son necesarios */
 
</style>